{
  "name": "jeopardy-desktop",
  "productName": "JeoPARTY!",
  "description": "JeoPARTY! Modern trivia game show for macOS",
  "author": "Ronak Gandhi",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronakg/jeoparty.git"
  },
  "private": true,
  "license": "MIT",
  "version": "1.2.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "release": "npm run build && electron-builder --mac --publish never",
    "dev": "vite",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --packages=external --outfile=dist-electron/preload.cjs && cp dist-electron/preload.cjs dist-electron/preload.js && node scripts/patchElectronDevApp.js",
    "build": "tsc && vite build && npm run build:electron",
    "test": "esbuild tests/index.test.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-test/test.js && node --test dist-test/test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,electron,tests}/**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"{src,electron,tests}/**/*.{ts,tsx,js}\"",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "build:app": "npm run build && electron-builder --mac dir --publish never",
    "open:app": "open release/mac*/JeoPARTY.app"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "extract-zip": "^2.0.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jeoparty.desktop",
    "productName": "JeoPARTY!",
    "artifactName": "JeoParty-${version}-${arch}.${ext}",
    "executableName": "JeoPARTY",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JeoParty-${version}-macOS-Intel.${ext}",
      "identity": null
    },
    "dmg": {
      "title": "JeoParty ${version}",
      "icon": "build/icon.icns",
      "artifactName": "JeoParty-${version}-macOS-AppleSilicon.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "JeoParty-${version}-Windows-x64.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JeoPARTY!",
      "differentialPackage": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "build/icon.icns",
      "build/icon.png"
    ]
  }
}
